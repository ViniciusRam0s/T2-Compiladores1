(* JSON (RFC 8259). Exercita o lexico gerado: STRING tem classe negada
   e escapes, NUMBER tem partes opcionais e alternativas. *)
TOKENS
  STRING = /"([^"\\\n]|\\.)*"/ ;
  NUMBER = /-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?/ ;
  SKIP   = /[ \t\r\n]+/ ;

RULES
  json   = valor ;
  valor  = objeto | vetor | STRING | NUMBER | "true" | "false" | "null" ;
  objeto = "{" [ membro { "," membro } ] "}" ;
  membro = STRING ":" valor ;
  vetor  = "[" [ valor { "," valor } ] "]" ;
